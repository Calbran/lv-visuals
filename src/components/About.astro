---
---

<section id="about" class="about">
  <div class="container about-inner">

    <div class="photos reveal">
      <div class="photo-primary">
        <img
          src="/images/photographer-portrait-1_500d83d3.jpeg"
          alt="LV Visuals photographer"
          width="480"
          height="600"
        />
      </div>
      <div class="photo-secondary">
        <img
          src="/images/photographer-portrait-2_0df0ff50.jpeg"
          alt="LV Visuals photographer at work"
          width="280"
          height="340"
        />
      </div>
    </div>

    <div class="about-copy reveal">
      <span class="section-label">About</span>
      <h2 class="section-heading dark">Photography built<br />for real estate.</h2>
      <p>
        LV Visuals is a boutique real estate photography studio focused on one thing:
        helping agents and sellers present their properties at the highest possible level.
        Every shoot is approached with precision, every edit with intention.
      </p>
      <p>
        We understand that time is a constraint and quality is non-negotiable. That is why every package
        includes professional delivery within 48 hours — no exceptions.
      </p>
      <a href="#contact" class="btn-dark">Get in Touch</a>
    </div>

    <div class="about-stat-grid reveal">
      {[
        { value: '48hr', label: 'Turnaround' },
        { value: '50+', label: 'Photos in Elite' },
        { value: '360°', label: 'Virtual Tours' },
        { value: '100%', label: 'MLS Ready' },
      ].map((s) => (
        <div class="stat">
          <span class="stat-value">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .about {
    background: var(--color-linen);
    padding-block: var(--section-y);
  }

  .about-inner {
    display: grid;
    grid-template-columns: 1fr 1.1fr 0.9fr;
    gap: var(--space-12);
    align-items: center;
  }

  /* Photos column */
  .photos {
    position: relative;
    height: 520px;
  }

  .photo-primary {
    position: absolute;
    top: 0;
    left: 0;
    width: 78%;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
  }

  .photo-primary img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    display: block;
  }

  .photo-secondary {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 55%;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 3px solid var(--color-linen);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.10);
  }

  .photo-secondary img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    display: block;
  }

  /* Gold accent line */
  .photo-primary::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: var(--space-6);
    width: 48px;
    height: 3px;
    background: var(--color-gold);
    border-radius: 2px;
  }

  /* Copy column */
  .about-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .about-copy p {
    font-size: 14px;
    line-height: 1.75;
    color: var(--color-slate);
  }

  .btn-dark {
    display: inline-block;
    margin-top: var(--space-4);
    background: transparent;
    color: var(--color-obsidian);
    border: 1px solid var(--color-obsidian);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    padding: 11px 24px;
    transition: background var(--ease-fast), color var(--ease-fast);
    align-self: flex-start;
  }

  .btn-dark:hover {
    background: var(--color-obsidian);
    color: var(--color-warm-white);
  }

  /* Stats column */
  .about-stat-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .stat {
    background: var(--color-warm-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 300;
    color: var(--color-obsidian);
    line-height: 1;
  }

  .stat-label {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-slate);
  }

  @media (max-width: 1024px) {
    .about-inner {
      grid-template-columns: 1fr 1fr;
    }
    .photos { grid-row: span 2; }
  }

  @media (max-width: 768px) {
    .about-inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .photos {
      height: 360px;
      grid-row: auto;
    }
    .photo-primary img { height: 300px; }
    .photo-secondary img { height: 180px; }
  }
</style>
