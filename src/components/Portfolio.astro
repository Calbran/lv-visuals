---
const photos = [
  {
    src: '/images/san-antonio-real-estate-photography-luxury-pool-backyard.jpg',
    alt: 'San Antonio real estate photography — luxury pool and backyard',
    tall: true,
  },
  {
    src: '/images/san-antonio-real-estate-photography-twilight-exterior.jpg',
    alt: 'San Antonio real estate photography — twilight exterior shoot',
    tall: false,
  },
  {
    src: '/images/san-antonio-real-estate-photography-living-room-fireplace.jpg',
    alt: 'San Antonio real estate photography — living room with fireplace',
    tall: false,
  },
  {
    src: '/images/san-antonio-real-estate-photography-kitchen-island.jpg',
    alt: 'San Antonio real estate photography — kitchen with island',
    tall: false,
  },
];
---

<section id="portfolio" class="portfolio">
  <div class="container portfolio-header reveal">
    <span class="section-label">Portfolio</span>
    <h2 class="section-heading light">Work that speaks<br />for itself.</h2>
  </div>
  <div class="grid">
    {photos.map((p, i) => (
      <div class={`grid-item${p.tall ? ' grid-item--tall' : ''} reveal`} style={`transition-delay: ${i * 75}ms`}>
        <img src={p.src} alt={p.alt} loading="lazy" />
      </div>
    ))}
  </div>
</section>

<style>
  .portfolio {
    background: var(--color-obsidian);
    padding-block: var(--section-y);
  }

  .portfolio-header {
    margin-bottom: var(--space-12);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
  }

  .grid-item {
    overflow: hidden;
    border-radius: var(--radius-sm);
  }

  .grid-item--tall { grid-row: span 2; }

  .grid-item img {
    width: 100%;
    height: 100%;
    min-height: 280px;
    object-fit: cover;
    display: block;
    transition: transform var(--ease-standard);
  }

  .grid-item:hover img {
    transform: scale(1.03);
  }

  @media (max-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .grid-item--tall { grid-row: span 1; }
  }
</style>
