---
const photos = [
  {
    src: '/images/san-antonio-real-estate-photography-luxury-pool-backyard.jpg',
    alt: 'San Antonio real estate photography — luxury pool and backyard',
    tall: true,
  },
  {
    src: '/images/san-antonio-real-estate-photography-twilight-exterior.jpg',
    alt: 'San Antonio real estate photography — twilight exterior shoot',
    tall: false,
  },
  {
    src: '/images/san-antonio-real-estate-photography-living-room-fireplace.jpg',
    alt: 'San Antonio real estate photography — living room with fireplace',
    tall: false,
  },
  {
    src: '/images/san-antonio-real-estate-photography-kitchen-island.jpg',
    alt: 'San Antonio real estate photography — kitchen with island',
    tall: false,
  },
  {
    src: '/images/san-antonio-real-estate-photography-luxury-pool-backyard.jpg',
    alt: 'San Antonio real estate photography — luxury pool and backyard',
    tall: false,
  },
  {
    src: '/images/san-antonio-real-estate-photography-twilight-exterior.jpg',
    alt: 'San Antonio real estate photography — twilight exterior shoot',
    tall: false,
  },
];
---

<section id="portfolio" class="portfolio">
  <div class="container portfolio-header reveal">
    <span class="section-label">Portfolio</span>
    <h2 class="section-heading light">Work that speaks<br />for itself.</h2>
  </div>
  <div class="grid">
    {photos.map((p, i) => (
      <div class={`grid-item${p.tall ? ' grid-item--tall' : ''}${i === 5 ? ' mobile-only' : ''} reveal`} style={`transition-delay: ${i * 75}ms`}>
        <img src={p.src} alt={p.alt} loading="lazy" />
      </div>
    ))}
  </div>
</section>

<style>
  .portfolio {
    position: relative;
    background: #0A0A0A;
    padding-top: var(--section-y);
    padding-bottom: 0;
    overflow: hidden;
  }

  .portfolio::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/images/topographic-hr.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    mix-blend-mode: screen;
    opacity: 0.12;
    pointer-events: none;
    z-index: 0;
  }

  .portfolio-header {
    position: relative;
    z-index: 1;
    margin-bottom: var(--space-12);
  }

  .grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
  }

  .grid-item {
    overflow: hidden;
  }

  .grid-item--tall { grid-row: span 2; }

  .grid-item img {
    width: 100%;
    height: 100%;
    min-height: 280px;
    object-fit: cover;
    display: block;
    transition: transform var(--ease-standard);
  }

  .grid-item:hover img {
    transform: scale(1.03);
  }

  .mobile-only { display: none; }

  @media (max-width: 768px) {
    .mobile-only { display: block; }
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .grid-item--tall { grid-row: span 1; }
  }
</style>
