---
const placeholders = Array.from({ length: 6 }, (_, i) => ({
  id: i + 1,
  aspect: i % 3 === 0 ? 'tall' : 'wide',
}));
---

<section id="portfolio" class="portfolio">
  <div class="container portfolio-header reveal">
    <span class="section-label">Portfolio</span>
    <h2 class="section-heading light">Work that speaks<br />for itself.</h2>
  </div>
  <div class="grid">
    {placeholders.map((p, i) => (
      <div class={`grid-item grid-item--${p.aspect} reveal`} style={`transition-delay: ${i * 75}ms`}>
        <div class="placeholder-img" aria-label={`Portfolio photo ${p.id}`}>
          <span class="placeholder-label">Photo {p.id}</span>
        </div>
      </div>
    ))}
  </div>
  <div class="container portfolio-note reveal">
    <p>Add your photos to <code>public/images/portfolio/</code> and update this component.</p>
  </div>
</section>

<style>
  .portfolio {
    background: var(--color-obsidian);
    padding-block: var(--section-y);
  }

  .portfolio-header {
    margin-bottom: var(--space-12);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
  }

  .grid-item {
    overflow: hidden;
    border-radius: var(--radius-sm);
  }

  .grid-item--tall { grid-row: span 2; }

  .placeholder-img {
    width: 100%;
    height: 100%;
    min-height: 280px;
    background: rgba(255, 255, 255, 0.04);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--ease-fast);
  }

  .grid-item:hover .placeholder-img {
    background: rgba(255, 255, 255, 0.07);
  }

  .placeholder-label {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.2);
  }

  .portfolio-note {
    margin-top: var(--space-8);
  }

  .portfolio-note p {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.3);
  }

  .portfolio-note code {
    color: var(--color-gold);
    font-family: monospace;
  }

  @media (max-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .grid-item--tall { grid-row: span 1; }
  }
</style>
