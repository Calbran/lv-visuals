---
const year = new Date().getFullYear();
---

<footer>
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="logo">LV Visuals</a>
      <p>Real estate photography delivered with precision.</p>
    </div>
    <nav class="footer-nav">
      <span class="footer-nav-label">Navigation</span>
      <ul>
        <li><a href="#services">Services</a></li>
        <li><a href="#addons">Add-Ons</a></li>
        <li><a href="#portfolio">Portfolio</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#contact">Book Now</a></li>
      </ul>
    </nav>
    <div class="footer-contact">
      <span class="footer-nav-label">Contact</span>
      <ul>
        <li><a href="mailto:hello@lvvisuals.com">hello@lvvisuals.com</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container">
      <p>&copy; {year} LV Visuals. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--color-obsidian);
    padding-top: var(--space-16);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-12);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .logo {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 300;
    letter-spacing: 0.16em;
    color: var(--color-warm-white);
    display: block;
    margin-bottom: var(--space-3);
  }

  .footer-brand p {
    font-size: 13px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.35);
    line-height: 1.6;
    max-width: 260px;
  }

  .footer-nav-label {
    display: block;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.3);
    margin-bottom: var(--space-4);
  }

  .footer-nav ul,
  .footer-contact ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-nav a,
  .footer-contact a {
    font-size: 13px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.55);
    transition: color var(--ease-fast);
  }

  .footer-nav a:hover,
  .footer-contact a:hover {
    color: var(--color-warm-white);
  }

  .footer-bottom {
    padding-block: var(--space-6);
  }

  .footer-bottom p {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.2);
    letter-spacing: 0.04em;
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: span 2;
    }
  }
</style>
